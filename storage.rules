rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Repeats `canSeeView` from packages/common/src/views.ts because storage
    // rules cannot import code.
    function canSeeView(viewId) {
      let user = firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data;
      let viewPath = /databases/(default)/documents/views/$(viewId);
      let view = firestore.get(viewPath).data;
      return request.auth != null
        && user.stage == 'ACTIVE'
        && firestore.exists(viewPath)
        && (
          view.authorUid == request.auth.uid
          || view.shareOption != 'PRIVATE'
          || user.role == 'Global Admin'
        );
    }
    
    // Each user has one profile photo, `avatar`, in their own folder, which is
    // how the backend tells whose photo a path is. Uploading again overwrites
    // it, so a user can never store more than one file. Only the backend,
    // using the Admin SDK, deletes photos.
    match /profile-photos/{uid}/{file} {
      // Users who are not approved yet may only see their own photo.
      // Approval is read from the same `users/{uid}` document the backend uses.
      allow read: if request.auth != null
        && (request.auth.uid == uid
          || firestore.get(
            /databases/(default)/documents/users/$(request.auth.uid)
          ).data.stage == 'ACTIVE');
      // Keep the types and the size cap in step with
      // packages/common/src/profilePhoto.ts.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && file == 'avatar'
        && request.resource.contentType.matches('image/(png|jpeg|webp)')
        && request.resource.size <= 10 * 1024 * 1024;
    }

    // Report PDFs live in their view's folder. Visibility follows the view, and
    // clients may only add files, never replace or delete them.
    match /reports/{viewId}/{file} {
      allow read: if canSeeView(viewId);
      // Keep the size cap in step with MAX_REPORT_BYTES in
      // packages/common/src/reports.ts.
      allow create: if canSeeView(viewId)
        && file.matches('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}[.]pdf')
        && request.resource.contentType == 'application/pdf'
        && request.resource.size <= 200 * 1024 * 1024;
    }
  }
}